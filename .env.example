# Sandesh Barde Portfolio Environment Configuration

# App Environment: development | production
APP_ENV=development

# Frontend & Public URL
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=

# Database Connection (PostgreSQL or SQLite)
# For local PostgreSQL via Docker: postgresql+psycopg://portfolio_user:portfolio_pass@localhost:5432/sandesh_portfolio
# For local SQLite zero-setup: sqlite+aiosqlite:///./portfolio.db
DATABASE_URL=sqlite:///./portfolio.db

# Authentication & Session Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=c9b2f4a18e03d7c5819034e62a1b75df98412e604719283f5c71b0293847561a
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12

# One-time Admin Bootstrap (Optional CLI/Env bootstrap)
ADMIN_BOOTSTRAP_EMAIL=sandeshbarde2214@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisStrongPass123!

# Email Dispatch (Optional - Inquiries are always saved to DB even if empty)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CONTACT_RECEIVER_EMAIL=sandeshbarde2214@gmail.com

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
